DATABASE_URL=file:./data/local.db
DATABASE_AUTH_TOKEN=
SESSION_SECRET=            # >= 32 random chars; refuse to start in production if missing
ALLOW_SIGNUP=true          # set false after creating your account in production

# AI Vietnamese Meaning Suggestions (Chọn Google Gemini hoặc Anthropic Claude):
# 1. Google Gemini (Khuyến nghị: Miễn phí 1.500 req/ngày tại https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# 2. Anthropic Claude (Tùy chọn)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Lựa chọn ưu tiên: 'gemini' | 'anthropic' (mặc định tự nhận diện key có sẵn)
LLM_PROVIDER=

LLM_DAILY_CAP=200          # max LLM lookups per day across the app
